# Redis connection URL with password authentication
REDIS_URL=redis://:placeholder_password@127.0.0.1:6379

# JWT secret key for signing tokens (8-hour session lifetime)
JWT_SECRET=replace_with_a_secure_jwt_secret_key

# Human admin account credentials (bcrypt hash generated with scripts/hash-password.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$placeholderBcryptHashForAdminUserGoesHere

# ML Service service account credentials
ML_SERVICE_USERNAME=ml-service
ML_SERVICE_PASSWORD_HASH=$2b$10$placeholderBcryptHashForMLServiceGoesHere

# HTTP and WebSocket port and host
PORT=4000
HOST=127.0.0.1

# DPI Engine management options
ENGINE_CONTROL_ENABLED=true
ENGINE_BIN=/path/to/AegisDPI/engine/build/dpi_engine

# Safe blocking policy configuration
# Comma-separated TTL ladder for ML blocks in seconds (e.g. 10m, 1h, 24h)
ML_BLOCK_TTL_LADDER=600,3600,86400
# Time window in seconds during which repeat offenses escalate the block TTL
ML_STRIKE_WINDOW_S=86400
# Interval in milliseconds between expired block sweeps
BLOCK_SWEEP_INTERVAL_MS=5000
