# Redis connection URL
REDIS_URL=redis://:placeholder_password@127.0.0.1:6379

# Middleware API base URL
MIDDLEWARE_URL=http://localhost:4000

# ML service account credentials for automated blocklist enforcement (/api/rules)
ML_SERVICE_USERNAME=ml-service
ML_SERVICE_PASSWORD=placeholder_ml_service_password

# Comma-separated list of IPv4 addresses ignored from anomaly scoring
ML_IGNORE_IPS=10.10.0.1,172.21.38.198

# Active ML detector model version: "v3" (IsolationForest + envelope guard, default) or "v1" (legacy volumetric)
ML_MODEL_VERSION=v3

# Auto-mitigation debounce cooldown in seconds (debounces POST /api/rules per source IP during an ongoing attack)
ML_MITIGATION_COOLDOWN_S=10

# Telegram notification bot integration (optional)
TELEGRAM_BOT_TOKEN=placeholder_telegram_bot_token
TELEGRAM_CHAT_ID=placeholder_telegram_chat_id
